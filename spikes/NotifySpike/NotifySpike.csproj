<Project Sdk="Microsoft.NET.Sdk">
  <!-- THROWAWAY spike. Not part of NotWin.sln. Sparse-package identity: see AppxManifest.xml + register.ps1 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <!-- -p:UiAccess=true selects the uiAccess manifest (needs signing + Program Files, see spikes/install-spikes.ps1) -->
    <ApplicationManifest Condition="'$(UiAccess)' == 'true'">app.uiaccess.manifest</ApplicationManifest>
    <ApplicationManifest Condition="'$(UiAccess)' != 'true'">app.manifest</ApplicationManifest>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>
</Project>
