<Window x:Class="NotWin.Panel.QuickPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NotWin Quick Settings"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Width="400"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource Font.Grotesk}"
        FontSize="13"
        Foreground="{DynamicResource Shell.Text}">
    <Window.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource ScrollBar.Thin}" />
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource Shell.Dim}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <!-- Mockup .qsp: 400 wide, padding 18, radius 28, glass (solid per user feedback), max height 600. -->
    <Border x:Name="Panel" CornerRadius="{StaticResource Radius.Panel}" Background="{DynamicResource Shell.Glass}"
            BorderBrush="{DynamicResource Shell.Line}" BorderThickness="1" Padding="18">
        <Border.RenderTransform>
            <TranslateTransform x:Name="PanelShift" />
        </Border.RenderTransform>
        <ScrollViewer MaxHeight="564" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- Wi-Fi / Bluetooth tiles (2 columns, 8 gap) and their expandable lists (Tasks 10, 11). -->
                <StackPanel x:Name="TilesHost" />
                <!-- Volume + output chip, brightness (Tasks 8, 9). -->
                <StackPanel x:Name="SlidersHost" Margin="0,2,0,0" />
                <!-- Notifications (Task 12). -->
                <StackPanel x:Name="NotificationsHost" Margin="0,16,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
