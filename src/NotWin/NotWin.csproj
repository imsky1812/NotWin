<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest Condition="'$(UiAccess)' == 'true'">app.uiaccess.manifest</ApplicationManifest>
    <ApplicationManifest Condition="'$(UiAccess)' != 'true'">app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- Bundled OFL fonts (licenses alongside as Theme/Fonts/OFL-*.txt). -->
    <Resource Include="Theme\Fonts\*.ttf" />
    <None Include="Theme\Fonts\OFL-*.txt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NotWin.Core\NotWin.Core.csproj" />
    <ProjectReference Include="..\NotWin.Native\NotWin.Native.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Data.OleDb" Version="10.0.15" />
    <PackageReference Include="System.Management" Version="10.0.15" />
  </ItemGroup>

</Project>
