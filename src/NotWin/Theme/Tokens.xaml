<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    mc:Ignorable="po">

    <!-- Palette (spec §5). Alpha values: glass rgba(16,16,16,.90) = E6, line rgba(255,255,255,.10) = 1A. -->
    <SolidColorBrush x:Key="Brush.Card" Color="#FF1A1A1A" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Tile" Color="#FF161616" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.TileHover" Color="#FF202020" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Glass" Color="#E6101010" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Line" Color="#1AFFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Text" Color="#FFE8E8E8" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Dim" Color="#FF999999" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Red" Color="#FFD71921" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Hover" Color="#14FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Active" Color="#1FFFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.RunDot" Color="#FFBBBBBB" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Ink" Color="#FF101010" po:Freeze="True" />

    <!-- Launcher (mockup final-v2 .scrim/.search/.best/.ri/.app/.round). -->
    <!-- User feedback 2026-11-18: the launcher glass read too see-through; denser panel and scrim. -->
    <SolidColorBrush x:Key="Brush.Scrim" Color="#73000000" po:Freeze="True" />
    <!-- Solid (no see-through): without a real blur a translucent panel only looks muddy (user feedback, twice). -->
    <SolidColorBrush x:Key="Brush.GlassDense" Color="#FF141414" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Field" Color="#0FFFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.BestCard" Color="#12FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.RowSel" Color="#17FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Circle" Color="#FF262626" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Placeholder" Color="#FF666666" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.SoftText" Color="#FFCCCCCC" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Icon" Color="#FFAAAAAA" po:Freeze="True" />

    <!-- Corner radii (DIP). -->
    <CornerRadius x:Key="Radius.Dock">30</CornerRadius>
    <CornerRadius x:Key="Radius.Panel">28</CornerRadius>
    <CornerRadius x:Key="Radius.Widget">26</CornerRadius>
    <CornerRadius x:Key="Radius.Tile">22</CornerRadius>

    <!-- Bundled OFL fonts (Theme/Fonts, embedded as resources). The name after # is the font's family name.
         Nothing design pass (user, 2026-11-21): Space Grotesk for text, Space Mono for labels and numbers. Both are
         static files (Space Grotesk Regular / Medium / Bold from floriankarsten/space-grotesk, Space Mono Regular /
         Bold), so FontWeight picks a real weight: WPF only renders a variable font's default instance, which looked
         too light (user feedback 2026-11-18). Geist stays bundled but unused. -->
    <FontFamily x:Key="Font.Grotesk">pack://application:,,,/NotWin;component/Theme/Fonts/#Space Grotesk</FontFamily>
    <FontFamily x:Key="Font.Mono">pack://application:,,,/NotWin;component/Theme/Fonts/#Space Mono</FontFamily>
    <FontFamily x:Key="Font.Geist">pack://application:,,,/NotWin;component/Theme/Fonts/#Geist</FontFamily>
    <FontFamily x:Key="Font.GeistMono">pack://application:,,,/NotWin;component/Theme/Fonts/#Geist Mono</FontFamily>
    <FontFamily x:Key="Font.Serif">pack://application:,,,/NotWin;component/Theme/Fonts/#DM Serif Display</FontFamily>

    <!-- Motion: cubic-bezier(.2,.8,.2,1). -->
    <KeySpline x:Key="Ease.Standard" ControlPoint1="0.2,0.8" ControlPoint2="0.2,1" po:Freeze="True" />


        <!-- Thin scrollbar (user feedback 2026-11-18): no arrows, transparent track, 6 px rounded grey thumb that
             brightens on hover / drag. -->
        <Style x:Key="Thumb.Thin" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="T" CornerRadius="3" Background="#FF3A3A3A" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="T" Property="Background" Value="#FF5A5A5A" /></Trigger>
                            <Trigger Property="IsDragging" Value="True"><Setter TargetName="T" Property="Background" Value="#FF999999" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollBar.Thin" TargetType="ScrollBar">
            <Setter Property="Width" Value="6" />
            <Setter Property="MinWidth" Value="6" />
            <Setter Property="Margin" Value="6,4,0,4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Thumb.Thin}" MinHeight="32" />
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

</ResourceDictionary>
