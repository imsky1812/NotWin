<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    mc:Ignorable="po">

    <!-- Palette (spec §5). Alpha values: glass rgba(16,16,16,.90) = E6, line rgba(255,255,255,.10) = 1A. -->
    <SolidColorBrush x:Key="Brush.Card" Color="#FF1A1A1A" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Tile" Color="#FF161616" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.TileHover" Color="#FF202020" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Glass" Color="#E6101010" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Line" Color="#1AFFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Text" Color="#FFF2F2F2" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Dim" Color="#FF8A8A8A" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Red" Color="#FFE8231F" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Hover" Color="#14FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Active" Color="#1FFFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.RunDot" Color="#FFBBBBBB" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Ink" Color="#FF101010" po:Freeze="True" />

    <!-- Corner radii (DIP). -->
    <CornerRadius x:Key="Radius.Dock">30</CornerRadius>
    <CornerRadius x:Key="Radius.Panel">28</CornerRadius>
    <CornerRadius x:Key="Radius.Widget">26</CornerRadius>
    <CornerRadius x:Key="Radius.Tile">22</CornerRadius>

    <!-- Bundled OFL fonts (Theme/Fonts, embedded as resources). The name after # is the font's family name.
         Space Grotesk, Geist and Geist Mono are variable fonts; WPF only renders their default instance
         (Space Grotesk: Light, Geist/Geist Mono: Regular) and synthesizes bold. -->
    <FontFamily x:Key="Font.Grotesk">pack://application:,,,/NothingShell;component/Theme/Fonts/#Space Grotesk</FontFamily>
    <FontFamily x:Key="Font.Mono">pack://application:,,,/NothingShell;component/Theme/Fonts/#Space Mono</FontFamily>
    <FontFamily x:Key="Font.Geist">pack://application:,,,/NothingShell;component/Theme/Fonts/#Geist</FontFamily>
    <FontFamily x:Key="Font.GeistMono">pack://application:,,,/NothingShell;component/Theme/Fonts/#Geist Mono</FontFamily>
    <FontFamily x:Key="Font.Serif">pack://application:,,,/NothingShell;component/Theme/Fonts/#DM Serif Display</FontFamily>

    <!-- Motion: cubic-bezier(.2,.8,.2,1). -->
    <KeySpline x:Key="Ease.Standard" ControlPoint1="0.2,0.8" ControlPoint2="0.2,1" po:Freeze="True" />

</ResourceDictionary>
