<Window x:Class="NothingShell.Dock.DockPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nothing Shell Dock Popup"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource Font.Grotesk}"
        FontWeight="Medium"
        FontSize="12.5"
        Foreground="{StaticResource Brush.Text}">
    <!-- Small glass list shown above a dock item: window titles, or the right-click actions. -->
    <Border CornerRadius="18"
            Background="{StaticResource Brush.Glass}"
            BorderBrush="{StaticResource Brush.Line}"
            BorderThickness="1"
            Padding="6">
        <ItemsControl x:Name="Rows" MinWidth="140" MaxWidth="320">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="Row" CornerRadius="12" Padding="10,7" Background="Transparent"
                            MouseLeftButtonUp="OnRowUp">
                        <StackPanel Orientation="Horizontal">
                            <!-- Tick column only on checkable rows (Checked is not null). -->
                            <Path x:Name="Tick" Width="12" Height="12" Margin="0,0,8,0" Visibility="Collapsed"
                                  Stretch="Uniform" Data="M2,6.5 L5,9.5 L10,3" Stroke="{StaticResource Brush.Text}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Opacity="0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Checked}" Value="False">
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Checked}" Value="True">
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Tick" Property="Opacity" Value="1" />
                        </DataTrigger>
                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource Brush.Hover}" />
                        </Trigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</Window>
