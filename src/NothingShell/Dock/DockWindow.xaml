<Window x:Class="NothingShell.Dock.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nothing Shell Dock"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        SizeToContent="Manual"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource Font.Geist}"
        Foreground="{StaticResource Brush.Text}">

    <!-- The window spans from the pill's top down to the screen bottom (pill + 12 DIP gap), so the pill can
         slide in from below the screen edge; the window clips it. Fully transparent pixels are click-through. -->
    <Grid ClipToBounds="True">
        <Border x:Name="Pill"
                Height="60"
                VerticalAlignment="Top"
                CornerRadius="{StaticResource Radius.Dock}"
                Background="{StaticResource Brush.Glass}"
                BorderBrush="{StaticResource Brush.Line}"
                BorderThickness="1"
                Padding="10,0"
                Opacity="0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="Slide" Y="90" />
            </Border.RenderTransform>
            <!-- Items (Task 12) and the tray (Task 14) go here. -->
        </Border>
    </Grid>
</Window>
