<Window x:Class="NothingShell.Dock.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nothing Shell Dock"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        SizeToContent="Manual"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource Font.Geist}"
        Foreground="{StaticResource Brush.Text}">

    <!-- The window spans from the pill's top down to the screen bottom (pill + 12 DIP gap), so the pill can
         slide in from below the screen edge; the window clips it. Fully transparent pixels are click-through. -->
    <Grid ClipToBounds="True">
        <Border x:Name="Pill"
                Height="60"
                VerticalAlignment="Top"
                CornerRadius="{StaticResource Radius.Dock}"
                Background="{StaticResource Brush.Glass}"
                BorderBrush="{StaticResource Brush.Line}"
                BorderThickness="1"
                Padding="10,0"
                Opacity="0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="Slide" Y="90" />
            </Border.RenderTransform>
            <ItemsControl x:Name="ItemsHost" ItemsSource="{Binding Items}" VerticalAlignment="Center"
                          HorizontalAlignment="Center" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- 44x44 hit area, 22 px greyscale icon; dot = running (#BBBBBB), focused = red + lit background. -->
                        <Border x:Name="Slot" Width="44" Height="44" Margin="2,0" CornerRadius="14"
                                Background="Transparent" ToolTip="{Binding DisplayName}"
                                MouseLeftButtonUp="OnItemLeftUp" MouseRightButtonUp="OnItemRightUp">
                            <Grid>
                                <Image Source="{Binding Icon}" Width="22" Height="22"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <Ellipse x:Name="Dot" Width="4" Height="4" Fill="#FFBBBBBB" Visibility="Collapsed"
                                         VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,2" />
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <Trigger SourceName="Slot" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Slot" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Running}" Value="True">
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Focused}" Value="True">
                                <Setter TargetName="Slot" Property="Background" Value="#1FFFFFFF" />
                                <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Brush.Red}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </Grid>
</Window>
