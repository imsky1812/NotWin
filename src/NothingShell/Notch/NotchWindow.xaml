<Window x:Class="NothingShell.Notch.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NothingShell.Notch"
        Title="Nothing Shell Notch"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        SizeToContent="Manual"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource Font.Grotesk}"
        Foreground="{StaticResource Brush.Text}">
    <!-- The window is a fixed transparent band at the top centre; only the pill inside is painted. The whole band is
         click-through (WS_EX_TRANSPARENT) except while the dashboard is open. Pill sizes per state (spec §6.4): resting
         196x34, music 300x34, notification 420x64, open 770 x content. -->
    <Grid>
        <Border x:Name="Pill" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0"
                Width="196" Height="34" CornerRadius="20" Background="#FF000000"
                BorderBrush="#14FFFFFF" BorderThickness="1" ClipToBounds="True">
            <Grid>
                <!-- Resting: dot-matrix time | battery -->
                <DockPanel x:Name="RestLayer" Margin="14,0" Opacity="1">
                    <StackPanel x:Name="BatteryPanel" Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <Grid Width="20" Height="10" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Border BorderBrush="#FFDDDDDD" BorderThickness="1.2" CornerRadius="2.5" Margin="0,0,2,0" />
                            <Border x:Name="BatteryFill" HorizontalAlignment="Left" Margin="2,2,0,2" Width="12" CornerRadius="1" Background="#FFDDDDDD" />
                            <Border HorizontalAlignment="Right" Width="1.6" Height="4" CornerRadius="0.8" Background="#FFDDDDDD" />
                            <TextBlock x:Name="Bolt" Text="⚡" FontSize="8" Foreground="#FF000000" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Margin="0,0,2,0" Visibility="Collapsed" />
                        </Grid>
                        <TextBlock x:Name="BatteryText" FontFamily="{StaticResource Font.Mono}" FontWeight="Medium" FontSize="11"
                                   Foreground="#FFDDDDDD" VerticalAlignment="Center" />
                    </StackPanel>
                    <!-- Mockup rtime: dots(h:m, {d:2.6, gap:1, fill:'#eee'}) -->
                    <local:DotMatrix x:Name="Clock" Dot="2.6" Gap="1" Fill="#FFEEEEEE" VerticalAlignment="Center" HorizontalAlignment="Left" />
                </DockPanel>

                <!-- Timer (Plan 4): mini 5x5 grid timer | dot countdown (mockup l-timer: gridTimer(22,5) + dots 2.6/1 #eee) -->
                <DockPanel x:Name="TimerLayer" Margin="14,0" Opacity="0">
                    <Border x:Name="TimerGridHost" Width="22" Height="22" VerticalAlignment="Center" DockPanel.Dock="Left" />
                    <local:DotMatrix x:Name="TimerText" Dot="2.6" Gap="1" Fill="#FFEEEEEE" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </DockPanel>

                <!-- Opening ‹name›… -->
                <StackPanel x:Name="OpeningLayer" Orientation="Horizontal" Margin="16,0" Opacity="0" VerticalAlignment="Center">
                    <TextBlock Text="Opening " FontSize="12" Foreground="{StaticResource Brush.Dim}" />
                    <TextBlock x:Name="OpeningName" FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis" MaxWidth="200" />
                    <TextBlock Text="…" FontSize="12" Foreground="{StaticResource Brush.Dim}" />
                </StackPanel>

                <!-- Plugged in / unplugged: bolt + label | level dots + percent in dots (user request 2026-11-19) -->
                <DockPanel x:Name="PowerLayer" Margin="16,0" Opacity="0">
                    <TextBlock x:Name="PowerBolt" Text="⚡" FontSize="13" Foreground="#FFD71921" DockPanel.Dock="Left"
                               VerticalAlignment="Center" Margin="0,0,7,1" />
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <local:DotBar x:Name="PowerBar" Dot="4" Gap="2" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <local:DotMatrix x:Name="PowerPercent" Dot="2.6" Gap="1" Fill="#FFEEEEEE" VerticalAlignment="Center" />
                        <TextBlock Text="%" FontFamily="{StaticResource Font.Mono}" FontWeight="Medium" FontSize="11"
                                   Foreground="{StaticResource Brush.Dim}" VerticalAlignment="Center" Margin="2,0,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="PowerLabel" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>

                <!-- Music (user feedback 2026-11-19): round art filling the pill's end | title · artist (scrolls when long) |
                     equalizer -->
                <DockPanel x:Name="MusicLayer" Margin="5,0,14,0" Opacity="0">
                    <Ellipse x:Name="ArtCircle" Width="24" Height="24" Fill="#FF3A3A3A" VerticalAlignment="Center"
                             DockPanel.Dock="Left" Margin="0,0,10,0" />
                    <local:DotColumns x:Name="Equalizer" Dot="3" Gap="2" DockPanel.Dock="Right" VerticalAlignment="Center"
                                      Margin="10,0,0,0" />
                    <Canvas x:Name="TrackClip" Height="16" VerticalAlignment="Center" ClipToBounds="True">
                        <TextBlock x:Name="TrackText" FontSize="12" Canvas.Top="0">
                            <TextBlock.RenderTransform><TranslateTransform x:Name="TrackShift" /></TextBlock.RenderTransform>
                            <Run x:Name="TrackTitle" FontWeight="Medium" Foreground="#FFE8E8E8" /><Run x:Name="TrackDot" Foreground="#FF999999" /><Run x:Name="TrackArtist" Foreground="#FF999999" />
                        </TextBlock>
                    </Canvas>
                </DockPanel>

                <!-- Notification: icon | app + text | now (Task 6) -->
                <DockPanel x:Name="NotifyLayer" Margin="18,0" Opacity="0">
                    <Border Width="36" Height="36" CornerRadius="18" Background="#FF1D1D1D" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,14,0">
                        <Image x:Name="NotifyIcon" Width="20" Height="20" />
                    </Border>
                    <TextBlock Text="NOW" FontFamily="{StaticResource Font.Mono}" FontWeight="Medium" FontSize="11"
                               Foreground="{StaticResource Brush.Dim}" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,0,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="NotifyApp" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="NotifyText" FontSize="12" Foreground="#FFAAAAAA" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>

                <!-- Open dashboard (Plan 4): hover opens it; content comes from DashboardView -->
                <ContentControl x:Name="OpenLayer" Opacity="0" IsHitTestVisible="False" VerticalAlignment="Top"
                                HorizontalAlignment="Left" Focusable="False" />
            </Grid>
        </Border>
    </Grid>
</Window>
